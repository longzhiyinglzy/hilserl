<mujoco model="Scene">
  <include file="xMateSR3_with_gripper.xml"/>

  <option timestep="0.001" noslip_iterations="10" noslip_tolerance="1e-8"/>

  <statistic center="0.3 0 0.4" extent=".8"/>

  <visual>
    <!-- 关键：把环境光降下来，否则一片白灰没细节 -->
    <headlight diffuse="0.75 0.75 0.75" ambient="0.1 0.1 0.1" specular="0.12 0.12 0.12"/>
    <global azimuth="160" elevation="-20" offheight="720" offwidth="1280"/>
    <!-- 阴影更细（看孔边缘很重要） -->
    <quality offsamples="8" shadowsize="2048"/>
    <map znear="0.001"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <!-- 地面反射为 0，避免把亮光“反弹”到画面里 -->
    <material name="grid" texture="grid" texrepeat="2 2" texuniform="true" reflectance="0"/>
    <mesh name="power_mesh" file="power/meshes/base_link.STL" scale="1 1 1"/>
  </asset>

  <default>
    <default class="col_board">
      <geom contype="1" conaffinity="1"
            condim="6"
            friction="0.9 0.04 0.0002"
            margin="0.0002"
            solref="0.0015 1" solimp="0.98 0.998 0.0003"/>
    </default>
  </default>

  <worldbody>
    <camera name="front" pos="1.3 0.0 0.7" quat="0.5963678 0.3799282 0.3799282 0.5963678" fovy="45"/>

    <!-- 顶灯：整体补光，但强度降下来 -->
    <light name="top_fill" pos="0 0 3" dir="0 0 -1"
           diffuse="0.80 0.80 0.80" specular="0.03 0.03 0.03"/>

    <!-- 原来的 target 灯：继续用，但弱很多，并改为对准 assembly_target（更利于看孔位） -->
    <light name="target_fill" pos="0 -0.5 0.4" mode="targetbodycom" target="assembly_target"
           diffuse="0.25 0.25 0.25" specular="0.04 0.04 0.04"/>

    <!-- 新增：装配区域“斜侧聚光 key light”（最关键，让孔边缘有阴影/高光） -->
    <light name="key_spot"
           pos="0.62 0.02 0.22"
           mode="targetbodycom" target="assembly_target"
           diffuse="1.05 1.05 1.05" specular="0.12 0.12 0.12"
           cutoff="30" exponent="18"/>

    <!-- 新增：弱补光，避免阴影完全死黑 -->
    <light name="fill_soft"
           pos="0.40 0.30 0.18"
           mode="targetbodycom" target="assembly_target"
           diffuse="0.18 0.18 0.18" specular="0 0 0"/>

    <geom name="floor" size="3 3 0.01" type="plane" material="grid"
          contype="1" conaffinity="1"
          friction="1.0 0.02 0.0005"/>

    <!-- 画中画相机：保持你给的 -->
    <camera name="power_cam_front"
            pos="0.65 0.035 0.07"
            mode="targetbodycom" target="assembly_target"
            fovy="10"/>

    <camera name="power_cam_back"
            pos="0.3 0.12 0.15"
            mode="targetbodycom" target="assembly_target"
            fovy="5"/>

    <body name="power" pos="0.56 0.136 0" quat="0 0 0 1">
      <freejoint name="power"/>
      <inertial mass="0.5" pos="0 0 0" diaginertia="0.002 0.002 0.002"/>

      <!-- power 本体略微降一点亮度，避免“冲白” -->
      <geom name="power" type="mesh" mesh="power_mesh" mass="0"
            rgba="0.82 0.84 0.88 1" class="col_board"/>

      <!-- 装配瞄准点：保持你给的 -->
      <body name="assembly_target" pos="0.050 0.000 0.050">
        <geom type="sphere" size="0.001" rgba="1 0 0 0" contype="0" conaffinity="0"/>
      </body>
    </body>

    <body name="target" pos=".15 0 .5" quat="0 1 0 0" mocap="true">
      <geom name="target" type="box" size=".03 .03 .03" contype="0" conaffinity="0" rgba=".6 .3 .3 0"/>
    </body>
  </worldbody>

  <sensor>
    <framepos  name="power_pos"  objtype="geom" objname="power"/>
    <framequat name="power_quat" objtype="geom" objname="power"/>
  </sensor>
</mujoco>
